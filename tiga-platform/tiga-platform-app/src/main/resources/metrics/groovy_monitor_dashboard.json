{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "缓存命中率 (Cache Hit Rate)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(tiga_groovy_cache_hits_total)",
          "legendFormat": "Hits"
        },
        {
          "expr": "sum(tiga_groovy_cache_misses_total)",
          "legendFormat": "Misses (Compiles)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } },
          "color": { "mode": "palette-classic" },
          "mappings": []
        }
      }
    },
    {
      "title": "脚本执行耗时 Top 10 (Avg Ms)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "topk(10, rate(tiga_groovy_execution_seconds_sum[1m]) / rate(tiga_groovy_execution_seconds_count[1m]) * 1000)",
          "legendFormat": "{{scriptId}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 100 }] } }
      }
    },
    {
      "title": "内存缓存脚本总数 (Cache Size)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "expr": "tiga_groovy_cache_size" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "max": 2000 }
      }
    },
    {
      "title": "脚本执行 QPS (Requests/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (scriptId) (rate(tiga_groovy_execution_seconds_count[1m]))",
          "legendFormat": "{{scriptId}} QPS"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "reqps" }
      }
    },
    {
      "title": "长尾延迟 (P95/P99 Latency)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tiga_groovy_execution_seconds_bucket[5m]))) * 1000",
          "legendFormat": "P95 Latency (ms)"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tiga_groovy_execution_seconds_bucket[5m]))) * 1000",
          "legendFormat": "P99 Latency (ms)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["groovy", "tiga-engine"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Groovy Engine Monitoring Dashboard",
  "uid": "groovy-monitor"
}