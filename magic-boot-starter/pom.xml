<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.maousan</groupId>
    <artifactId>magic-boot-starter</artifactId>
    <version>0.0.5</version>
    <packaging>jar</packaging>
    <name>magic-boot-starter</name>
    <description>Magic Boot 基座聚合依赖，一行引入全部框架能力</description>
    <url>https://github.com/maousan/magic-boot</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>maou</name>
        </developer>
    </developers>
    <scm>
        <url>https://github.com/maousan/magic-boot</url>
        <connection>scm:git:https://github.com/maousan/magic-boot.git</connection>
    </scm>

    <dependencies>
        <!-- magic-api 核心 -->
        <dependency>
            <groupId>io.github.maousan</groupId>
            <artifactId>magic-api-spring-boot-starter</artifactId>
            <version>2.2.2</version>
        </dependency>

        <!-- magic-script -->
        <dependency>
            <groupId>io.github.maousan</groupId>
            <artifactId>magic-script</artifactId>
            <version>1.9.0</version>
        </dependency>

        <!-- magic-api 插件集 -->
        <dependency>
            <groupId>io.github.maousan</groupId>
            <artifactId>magic-api-plugin-redis</artifactId>
            <version>0.0.5</version>
        </dependency>
        <dependency>
            <groupId>io.github.maousan</groupId>
            <artifactId>magic-api-plugin-job</artifactId>
            <version>0.0.5</version>
        </dependency>
        <dependency>
            <groupId>io.github.maousan</groupId>
            <artifactId>magic-api-plugin-liteflow</artifactId>
            <version>0.0.5</version>
        </dependency>
        <dependency>
            <groupId>io.github.maousan</groupId>
            <artifactId>magic-api-plugin-excel</artifactId>
            <version>0.0.5</version>
        </dependency>
        <dependency>
            <groupId>io.github.maousan</groupId>
            <artifactId>magic-api-plugin-file</artifactId>
            <version>0.0.5</version>
        </dependency>
        <dependency>
            <groupId>io.github.maousan</groupId>
            <artifactId>magic-api-plugin-springdoc</artifactId>
            <version>0.0.5</version>
        </dependency>
        <dependency>
            <groupId>io.github.maousan</groupId>
            <artifactId>magic-api-plugin-mqtt</artifactId>
            <version>0.0.5</version>
        </dependency>

        <!-- PF4J 插件系统 -->
        <dependency>
            <groupId>io.github.maousan</groupId>
            <artifactId>magic-plugin-api</artifactId>
            <version>0.0.5</version>
        </dependency>
        <dependency>
            <groupId>io.github.maousan</groupId>
            <artifactId>magic-plugin</artifactId>
            <version>0.0.5</version>
        </dependency>

        <!-- Tiga 引擎 -->
        <dependency>
            <groupId>io.github.maousan</groupId>
            <artifactId>tiga-engine</artifactId>
            <version>0.0.5</version>
        </dependency>
        <dependency>
            <groupId>io.github.maousan</groupId>
            <artifactId>tiga-engine-spring</artifactId>
            <version>0.0.5</version>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
