# ===========================================
# Magic Boot Docker 环境变量配置示例
# ===========================================
# 复制此文件为 .env 并根据实际情况修改
# ===========================================

# -------------------------------------------
# 数据源模式选择
# -------------------------------------------
# 使用 Docker 内置数据库 (true/false)
# true: 启动内置的 MySQL 和 Redis
# false: 使用外部数据源，需要配置下面的外部连接信息
USE_DOCKER_DB=true

# -------------------------------------------
# MySQL 基础配置（可复用）
# -------------------------------------------
# Docker 内置 MySQL 端口
MYSQL_PORT=3306

# Docker 内置 MySQL 数据库配置
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=magic-boot
MYSQL_USER=magic
MYSQL_PASSWORD=Magic@2026

# 外部 MySQL 主机地址（使用 Docker 内置时填 mysql）
MYSQL_HOST=mysql

# -------------------------------------------
# Redis 基础配置
# -------------------------------------------
# Redis 是否启用 (true/false)
EXTEND_REDIS_ENABLED=true

# Docker 内置 Redis 端口和密码
REDIS_PORT=6379
REDIS_PASSWORD=Magic@Redis2026

# 外部 Redis 主机地址（使用 Docker 内置时填 redis）
REDIS_HOST=redis

# -------------------------------------------
# 应用配置
# -------------------------------------------
# 应用端口
APP_PORT=8089

# Spring Profile (dev/demo/online)
SPRING_PROFILES_ACTIVE=dev

# 上传目录
UPLOAD_DIR=/app/uploads

# -------------------------------------------
# 高级配置（使用基础变量拼接或直接指定）
# -------------------------------------------
# 注意：.env 文件不支持 ${VAR} 引用其他变量
# 如需拼接，请在 docker-compose.yml 中使用变量扩展

# 外部 MySQL 连接配置（USE_DOCKER_DB=false 时使用）
# 方式 1：手动拼接完整 URL（推荐，兼容性好）
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/magic-boot?useSSL=false&zeroDateTimeBehavior=convertToNull&useUnicode=true&characterEncoding=UTF8&autoReconnect=true&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=magic
SPRING_DATASOURCE_PASSWORD=Magic@2026

# 方式 2：使用 docker-compose.yml 中的变量扩展（Docker Compose v2.20+）
# 在 docker-compose.yml 中这样写：
# SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?参数...

# 外部 Redis 连接配置（USE_DOCKER_DB=false 时使用）
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=zintis
SPRING_DATA_REDIS_DATABASE=3

# -------------------------------------------
# Nginx 配置（生产环境）
# -------------------------------------------
# Nginx HTTP 端口
NGINX_HTTP_PORT=80
# Nginx HTTPS 端口
NGINX_HTTPS_PORT=443

# -------------------------------------------
# 使用示例
# -------------------------------------------
# 1. 使用 Docker 内置数据库：
#    docker-compose --profile docker-db up -d
#
# 2. 使用外部数据源：
#    docker-compose up -d
#
# 3. 启动可视化工具：
#    docker-compose --profile tools up -d
#
# 4. 生产环境（带 Nginx）：
#    docker-compose --profile production up -d
