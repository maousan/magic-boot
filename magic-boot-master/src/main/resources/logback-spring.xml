<!--        </layout>-->
<!--    </appender>-->

    <!-- 第三方库降噪 -->
    <logger name="com.alibaba.nacos" level="WARN"/>
    <logger name="org.springframework.amqp.rabbit" level="WARN"/>
    <logger name="io.lettuce" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.apache.catalina.connector.CoyoteAdapter" level="WARN"/>
    <logger name="org.springframework.cache" level="off"/>
    <logger name="org.springframework.jdbc.datasource.DataSourceTransactionManager" level="debug"/>
    <logger name="org.springframework.context.support.PostProcessorRegistrationDelegate" level="error"/>

    <root level="INFO">
        <springProfile name="dev">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="ASYNC_ALL" />
            <appender-ref ref="ASYNC_ERROR"/>
        </springProfile>
        <springProfile name="prod">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_ALL" />
            <appender-ref ref="ASYNC_ERROR"/>
        </springProfile>
    </root>

</configuration>