{
  "openapi": "3.0.3",
  "info": {
    "title": "个人中心 API 接口文档",
    "description": "Magic Boot 个人中心模块的 API 接口定义\n\n## 功能模块\n- 头像上传（支持裁剪）\n- 修改密码\n- 第三方账号绑定\n- 登录设备管理\n- 操作日志查看\n- 账号注销\n\n## 认证方式\n所有接口需要在请求头中携带 Bearer Token\n\n```\nAuthorization: Bearer <your_token>\n```",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@example.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080/api",
      "description": "开发环境"
    },
    {
      "url": "https://api.example.com",
      "description": "生产环境"
    }
  ],
  "tags": [
    {
      "name": "profile",
      "description": "个人中心相关接口"
    },
    {
      "name": "avatar",
      "description": "头像管理"
    },
    {
      "name": "password",
      "description": "密码管理"
    },
    {
      "name": "binding",
      "description": "第三方账号绑定"
    },
    {
      "name": "device",
      "description": "登录设备管理"
    },
    {
      "name": "log",
      "description": "操作日志"
    },
    {
      "name": "cancel",
      "description": "账号注销"
    }
  ],
  "paths": {
    "/system/user/avatar/update": {
      "post": {
        "tags": ["avatar", "profile"],
        "summary": "上传头像",
        "description": "上传用户头像，支持图片裁剪后上传",
        "operationId": "updateAvatar",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "裁剪后的头像图片文件"
                  }
                }
              },
              "encoding": {
                "file": {
                  "contentType": "image/jpeg, image/png"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvatarResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/system/user/password/update": {
      "post": {
        "tags": ["password", "profile"],
        "summary": "修改密码",
        "description": "修改当前用户的登录密码",
        "operationId": "updatePassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["oldPassword", "newPassword", "confirmPassword"],
                "properties": {
                  "oldPassword": {
                    "type": "string",
                    "format": "password",
                    "description": "原密码",
                    "example": "OldPass123!"
                  },
                  "newPassword": {
                    "type": "string",
                    "format": "password",
                    "description": "新密码",
                    "minLength": 8,
                    "maxLength": 32,
                    "example": "NewPass456!"
                  },
                  "confirmPassword": {
                    "type": "string",
                    "format": "password",
                    "description": "确认新密码",
                    "example": "NewPass456!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "密码修改成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                },
                "examples": {
                  "password-mismatch": {
                    "summary": "两次密码不一致",
                    "value": {
                      "code": 400,
                      "message": "两次输入的密码不一致",
                      "data": null,
                      "timestamp": 1710123456789,
                      "executeTime": 10
                    }
                  },
                  "weak-password": {
                    "summary": "密码强度不足",
                    "value": {
                      "code": 400,
                      "message": "密码强度不足，请包含大小写字母、数字和特殊字符",
                      "data": null,
                      "timestamp": 1710123456789,
                      "executeTime": 10
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/system/user/bindings": {
      "get": {
        "tags": ["binding", "profile"],
        "summary": "获取第三方账号绑定列表",
        "description": "获取当前用户已绑定的第三方账号列表",
        "operationId": "getBindings",
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/BindingInfo"
                      }
                    },
                    "timestamp": {
                      "type": "integer",
                      "example": 1710123456789
                    },
                    "executeTime": {
                      "type": "integer",
                      "example": 15
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/system/user/bind": {
      "post": {
        "tags": ["binding", "profile"],
        "summary": "绑定第三方账号",
        "description": "绑定指定的第三方平台账号",
        "operationId": "bindAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["platform"],
                "properties": {
                  "platform": {
                    "type": "string",
                    "description": "第三方平台标识",
                    "enum": ["wechat", "dingtalk", "feishu", "github"],
                    "example": "wechat"
                  },
                  "authCode": {
                    "type": "string",
                    "description": "第三方平台授权码（可选，部分平台需要）",
                    "example": "AUTH_CODE_123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "绑定成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          },
          "400": {
            "description": "绑定失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                },
                "examples": {
                  "already-bound": {
                    "summary": "已绑定",
                    "value": {
                      "code": 400,
                      "message": "该账号已绑定其他用户",
                      "data": null,
                      "timestamp": 1710123456789,
                      "executeTime": 20
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/system/user/unbind": {
      "post": {
        "tags": ["binding", "profile"],
        "summary": "解绑第三方账号",
        "description": "解绑指定的第三方平台账号",
        "operationId": "unbindAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["platform"],
                "properties": {
                  "platform": {
                    "type": "string",
                    "description": "第三方平台标识",
                    "enum": ["wechat", "dingtalk", "feishu", "github"],
                    "example": "wechat"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "解绑成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          },
          "400": {
            "description": "解绑失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                },
                "examples": {
                  "not-bound": {
                    "summary": "未绑定",
                    "value": {
                      "code": 400,
                      "message": "该账号未绑定",
                      "data": null,
                      "timestamp": 1710123456789,
                      "executeTime": 15
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/system/user/devices": {
      "get": {
        "tags": ["device", "profile"],
        "summary": "获取登录设备列表",
        "description": "获取当前用户所有登录设备的信息",
        "operationId": "getDevices",
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DeviceInfo"
                      }
                    },
                    "timestamp": {
                      "type": "integer",
                      "example": 1710123456789
                    },
                    "executeTime": {
                      "type": "integer",
                      "example": 25
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/system/user/device/kickout": {
      "post": {
        "tags": ["device", "profile"],
        "summary": "踢下线设备",
        "description": "将指定设备踢下线",
        "operationId": "kickoutDevice",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["deviceId"],
                "properties": {
                  "deviceId": {
                    "type": "string",
                    "description": "设备ID",
                    "example": "DEVICE_123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "踢下线成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          },
          "400": {
            "description": "踢下线失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                },
                "examples": {
                  "current-device": {
                    "summary": "不能踢下线当前设备",
                    "value": {
                      "code": 400,
                      "message": "不能踢下线当前登录设备",
                      "data": null,
                      "timestamp": 1710123456789,
                      "executeTime": 10
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/system/user/logs": {
      "get": {
        "tags": ["log", "profile"],
        "summary": "获取操作日志列表",
        "description": "分页查询当前用户的操作日志",
        "operationId": "getLogs",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "当前页码",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "每页数量",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "description": "搜索关键词（操作名称或路径）",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startTime",
            "in": "query",
            "description": "开始时间（时间戳）",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "endTime",
            "in": "query",
            "description": "结束时间（时间戳）",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "list": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/LogInfo"
                          }
                        },
                        "total": {
                          "type": "integer",
                          "description": "总记录数",
                          "example": 100
                        }
                      }
                    },
                    "timestamp": {
                      "type": "integer",
                      "example": 1710123456789
                    },
                    "executeTime": {
                      "type": "integer",
                      "example": 30
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/system/user/cancel": {
      "post": {
        "tags": ["cancel", "profile"],
        "summary": "注销账号",
        "description": "注销当前用户账号\n\n**警告：此操作不可逆！**\n- 所有个人数据将被永久删除\n- 账号将无法恢复\n- 建议在注销前备份重要数据",
        "operationId": "cancelAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["confirm"],
                "properties": {
                  "confirm": {
                    "type": "string",
                    "description": "确认文本，必须为\"确认注销\"",
                    "example": "确认注销"
                  },
                  "reason": {
                    "type": "string",
                    "description": "注销原因（可选）",
                    "example": "不再使用此系统"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "账号注销成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          },
          "400": {
            "description": "确认文本不正确",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                },
                "examples": {
                  "invalid-confirm": {
                    "summary": "确认文本不正确",
                    "value": {
                      "code": 400,
                      "message": "请输入正确的确认文本",
                      "data": null,
                      "timestamp": 1710123456789,
                      "executeTime": 5
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CommonResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "状态码，200表示成功",
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "提示信息",
            "example": "操作成功"
          },
          "data": {
            "type": "object",
            "description": "响应数据",
            "nullable": true
          },
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "时间戳",
            "example": 1710123456789
          },
          "executeTime": {
            "type": "integer",
            "description": "执行时间（毫秒）",
            "example": 15
          }
        }
      },
      "AvatarResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "头像更新成功"
          },
          "data": {
            "type": "string",
            "description": "新头像的URL地址",
            "example": "https://example.com/avatars/user_123.jpg"
          },
          "timestamp": {
            "type": "integer",
            "example": 1710123456789
          },
          "executeTime": {
            "type": "integer",
            "example": 150
          }
        }
      },
      "BindingInfo": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "第三方平台标识",
            "enum": ["wechat", "dingtalk", "feishu", "github"],
            "example": "wechat"
          },
          "bound": {
            "type": "boolean",
            "description": "是否已绑定",
            "example": true
          },
          "nickname": {
            "type": "string",
            "description": "第三方账号昵称",
            "example": "张三"
          },
          "bindTime": {
            "type": "string",
            "format": "date-time",
            "description": "绑定时间",
            "example": "2024-03-15 10:30:00"
          }
        }
      },
      "DeviceInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "设备ID",
            "example": "DEVICE_123456"
          },
          "deviceName": {
            "type": "string",
            "description": "设备名称",
            "example": "Chrome on Windows"
          },
          "deviceType": {
            "type": "string",
            "description": "设备类型",
            "enum": ["pc", "mobile", "tablet"],
            "example": "pc"
          },
          "browser": {
            "type": "string",
            "description": "浏览器信息",
            "example": "Chrome 122.0.0"
          },
          "os": {
            "type": "string",
            "description": "操作系统",
            "example": "Windows 11"
          },
          "ip": {
            "type": "string",
            "description": "IP地址",
            "example": "192.168.1.100"
          },
          "address": {
            "type": "string",
            "description": "登录地点",
            "example": "北京市朝阳区"
          },
          "loginTime": {
            "type": "string",
            "format": "date-time",
            "description": "登录时间",
            "example": "2024-03-15 09:00:00"
          },
          "lastActiveTime": {
            "type": "string",
            "format": "date-time",
            "description": "最后活动时间",
            "example": "2024-03-15 10:30:00"
          },
          "isCurrent": {
            "type": "boolean",
            "description": "是否为当前设备",
            "example": true
          }
        }
      },
      "LogInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "日志ID",
            "example": "LOG_123456"
          },
          "apiName": {
            "type": "string",
            "description": "接口名称",
            "example": "用户登录"
          },
          "apiPath": {
            "type": "string",
            "description": "请求路径",
            "example": "/system/security/login"
          },
          "apiMethod": {
            "type": "string",
            "description": "请求方法",
            "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"],
            "example": "POST"
          },
          "userIp": {
            "type": "string",
            "description": "IP地址",
            "example": "192.168.1.100"
          },
          "costTime": {
            "type": "integer",
            "description": "耗时（毫秒）",
            "example": 150
          },
          "status": {
            "type": "string",
            "description": "执行状态",
            "enum": ["success", "fail"],
            "example": "success"
          },
          "createTime": {
            "type": "string",
            "format": "date-time",
            "description": "操作时间",
            "example": "2024-03-15 10:30:00"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求参数错误",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CommonResponse"
            },
            "example": {
              "code": 400,
              "message": "请求参数错误",
              "data": null,
              "timestamp": 1710123456789,
              "executeTime": 5
            }
          }
        }
      },
      "Unauthorized": {
        "description": "未授权或Token失效",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CommonResponse"
            },
            "example": {
              "code": 401,
              "message": "未授权，请先登录",
              "data": null,
              "timestamp": 1710123456789,
              "executeTime": 5
            }
          }
        }
      },
      "InternalError": {
        "description": "服务器内部错误",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CommonResponse"
            },
            "example": {
              "code": 500,
              "message": "服务器内部错误",
              "data": null,
              "timestamp": 1710123456789,
              "executeTime": 100
            }
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Token 认证"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
