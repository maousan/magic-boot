@baseUrl = http://localhost:8089
@jobId = 0b605de92ec34e76b3340c565c31f791

### TC-1 暂停任务
POST {{baseUrl}}/system/job/{{jobId}}/pause
Content-Type: application/json

{}

> {%
client.test("暂停任务", function() {
  client.assert(response.status === 200, "HTTP状态码应为200");
  client.assert(response.body.code === 200, "业务码应为200");
});
%}

###

### TC-2 恢复任务
POST {{baseUrl}}/system/job/{{jobId}}/resume
Content-Type: application/json

{}

> {%
client.test("恢复任务", function() {
  client.assert(response.status === 200, "HTTP状态码应为200");
  client.assert(response.body.code === 200, "业务码应为200");
});
%}

