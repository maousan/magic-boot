### TC-2.7 下载不存在的文件
# @name 下载不存在的文件
GET {{baseUrl}}/system/file/browse/download?filePath=/non/existent/file.txt
Content-Type: application/json

> {%
client.test("下载不存在的文件", function() {
    // magic-api 的 exit 0 会返回 200，但在 body 中包含错误信息
    client.assert(response.status === 200, "HTTP状态码应为200");
});

client.log("✅ 不存在的文件验证成功");
%}

