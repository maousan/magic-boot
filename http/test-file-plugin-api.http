### TC-3.1 获取文件列表 - 不存在的目录
# @name 获取不存在的目录列表
GET {{baseUrl}}/system/file/browse/list?filePath=/non-existent-dir-{{ $timestamp }}/
Content-Type: application/json

> {%
client.test("获取不存在的目录列表", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(Array.isArray(response.body.files), "files应为数组");
    client.assert(response.body.files.length === 0, "不存在的目录应返回空数组");
});

client.log("✅ 不存在的目录返回空列表");
%}

###

### TC-3.2 获取文件列表 - 不带路径参数
# @name 获取文件列表-不带路径参数
GET {{baseUrl}}/system/file/browse/list
Content-Type: application/json

> {%
client.test("不带路径参数获取文件列表", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    // 应使用默认路径 /
    client.assert(response.body.currentPath === "/", "应使用默认路径/");
});

client.log("✅ 默认路径验证成功");
%}

###

### TC-3.3 上传大文件（模拟）
# @name 上传大文件
POST {{baseUrl}}/system/file/browse/upload?filePath=/large-files/
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="large-file-{{ $timestamp }}.bin"
Content-Type: application/octet-stream

< ./http/test-file.bin
--WebAppBoundary--

> {%
client.test("上传大文件", function() {
    // 如果文件不存在会失败，这是预期的
    if (response.status === 200) {
        client.log("✅ 大文件上传成功: " + response.body.fileSize + " bytes");
    } else {
        client.log("⚠️  测试文件不存在，跳过大文件测试");
    }
});
%}

