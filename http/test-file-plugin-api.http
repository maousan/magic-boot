### 文件存储插件测试脚本
### 使用 IDEA HTTP Client 执行测试

### 变量配置
@baseUrl = http://localhost:8089
@token = your-token-here

### ================================
### 模块 1: 存储管理 API 测试
### ================================

### TC-1.1 获取支持的存储类型
# @name 获取存储类型
GET {{baseUrl}}/file/storage/types
Content-Type: application/json

> {%
client.test("获取存储类型成功", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(response.body.data.length === 3, "应返回3种存储类型");

    var types = response.body.data.map(item => item.type);
    client.assert(types.includes("local"), "应包含本地存储");
    client.assert(types.includes("minio"), "应包含MinIO存储");
    client.assert(types.includes("s3"), "应包含S3存储");
});

client.log("✅ 存储类型: " + response.body.data.map(t => t.name).join(", "));
%}

###

### TC-1.2 测试本地存储连接 - 有效路径
# @name 测试本地存储连接
POST {{baseUrl}}/file/storage/test
Content-Type: application/json

{
  "type": "local",
  "properties": {
    "basePath": "./upload/",
    "domain": "http://localhost:8089"
  }
}

> {%
client.test("本地存储连接测试", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(response.body.data.success === true, "连接测试应成功");
    client.assert(response.body.data.canRead === true, "应具有读权限");
    client.assert(response.body.data.canWrite === true, "应具有写权限");
});

client.log("✅ 本地存储连接成功: " + response.body.data.message);
%}

###

### TC-1.3 测试本地存储连接 - 空路径
# @name 测试本地存储-空路径
POST {{baseUrl}}/file/storage/test
Content-Type: application/json

{
  "type": "local",
  "properties": {
    "basePath": ""
  }
}

> {%
client.test("空路径验证", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(response.body.data.success === false, "空路径应测试失败");
    client.assert(response.body.data.message.includes("不能为空"), "应提示路径不能为空");
});

client.log("✅ 空路径验证成功");
%}

###

### TC-1.4 测试 MinIO 存储连接 - 无效端点
# @name 测试MinIO连接-无效端点
POST {{baseUrl}}/file/storage/test
Content-Type: application/json

{
  "type": "minio",
  "properties": {
    "endpoint": "http://invalid-minio-host:9999",
    "bucket": "test-bucket",
    "accessKey": "minioadmin",
    "secretKey": "minioadmin"
  }
}

> {%
client.test("MinIO无效端点测试", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(response.body.data.success === false, "无效端点应测试失败");
});

client.log("✅ MinIO无效端点验证成功: " + response.body.data.message);
%}

###

### TC-1.5 测试 S3 存储连接 - 无效凭证
# @name 测试S3连接-无效凭证
POST {{baseUrl}}/file/storage/test
Content-Type: application/json

{
  "type": "s3",
  "properties": {
    "endpoint": "https://s3.amazonaws.com",
    "region": "us-east-1",
    "bucket": "test-bucket",
    "accessKey": "invalid-access-key",
    "secretKey": "invalid-secret-key"
  }
}

> {%
client.test("S3无效凭证测试", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(response.body.data.success === false, "无效凭证应测试失败");
});

client.log("✅ S3无效凭证验证成功: " + response.body.data.message);
%}

###

### TC-1.6 测试不支持的存储类型
# @name 测试不支持的存储类型
POST {{baseUrl}}/file/storage/test
Content-Type: application/json

{
  "type": "unsupported-type",
  "properties": {}
}

> {%
client.test("不支持的存储类型", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(response.body.data.success === false, "不支持的类型应测试失败");
    client.assert(response.body.data.message.includes("不支持的存储类型"), "应提示不支持的类型");
});

client.log("✅ 不支持的存储类型验证成功");
%}

