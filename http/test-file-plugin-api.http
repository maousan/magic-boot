### TC-2.6 下载文件
# @name 下载文件
GET {{baseUrl}}/system/file/browse/download?filePath={{uploadedFilePath}}
Content-Type: application/json

> {%
client.test("下载文件", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(response.headers["Content-Disposition"] !== undefined, "应包含Content-Disposition头");
});

client.log("✅ 文件下载成功");
%}

