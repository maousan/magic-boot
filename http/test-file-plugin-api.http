### ================================
### 模块 2: 文件操作 API 测试
### ================================

### TC-2.1 获取文件列表 - 根目录
# @name 获取文件列表-根目录
GET {{baseUrl}}/system/file/browse/list?dirPath=/
Content-Type: application/json

> {%
client.test("获取根目录文件列表", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(response.body.currentPath !== undefined, "应返回当前路径");
    client.assert(Array.isArray(response.body.files), "files应为数组");
});

client.log("✅ 根目录文件数量: " + response.body.total);
%}

###

### TC-2.2 获取文件列表 - 指定目录
# @name 获取文件列表-指定目录
GET {{baseUrl}}/system/file/browse/list?dirPath=/test/
Content-Type: application/json

> {%
client.test("获取指定目录文件列表", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(response.body.currentPath === "/test/", "当前路径应为/test/");
});

client.log("✅ /test/ 目录文件数量: " + response.body.total);
%}

###

### TC-2.3 上传文件 - 文本文件
# @name 上传文本文件
POST {{baseUrl}}/system/file/browse/upload?filePath=/test/
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="test.txt"
Content-Type: text/plain

This is a test file content.
Created at: {{ $timestamp }}
--WebAppBoundary--

> {%
client.test("上传文本文件", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(response.body.fileName !== undefined, "应返回文件名");
    client.assert(response.body.url !== undefined, "应返回文件URL");
    client.assert(response.body.fileSize > 0, "文件大小应大于0");
});

client.log("✅ 文件上传成功: " + response.body.fileName + " (" + response.body.fileSize + " bytes)");
client.global.set("uploadedFilePath", response.body.filePath);
client.global.set("uploadedFileUrl", response.body.url);
%}

###

### TC-2.4 上传文件 - 带中文文件名
# @name 上传中文文件名文件
POST {{baseUrl}}/system/file/browse/upload?filePath=/测试目录/
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="测试文件.txt"
Content-Type: text/plain; charset=utf-8

这是中文测试内容
--WebAppBoundary--

> {%
client.test("上传中文文件名文件", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(response.body.fileName.includes("测试"), "文件名应包含中文");
});

client.log("✅ 中文文件名上传成功: " + response.body.fileName);
%}

###

### TC-2.5 上传文件 - 不指定路径（使用默认路径）
# @name 上传文件-默认路径
POST {{baseUrl}}/system/file/browse/upload
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="default-path-test.txt"
Content-Type: text/plain

File uploaded to default path
--WebAppBoundary--

> {%
client.test("上传到默认路径", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
});

client.log("✅ 默认路径上传成功: " + response.body.filePath);
%}

###

### TC-2.5.1 创建文件夹 - 普通文件夹
# @name 创建文件夹-普通
POST {{baseUrl}}/system/file/browse/mkdir
Content-Type: application/x-www-form-urlencoded

parentPath=/test/&name=test-folder-{{ $timestamp }}

> {%
client.test("创建文件夹", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(response.body.name !== undefined, "应返回文件夹名称");
    client.assert(response.body.path !== undefined, "应返回文件夹路径");
    client.assert(response.body.isDirectory === true, "应标识为目录");
});

client.log("✅ 文件夹创建成功: " + response.body.name + " (" + response.body.path + ")");
client.global.set("createdFolderPath", response.body.path);
%}

###

### TC-2.5.2 创建文件夹 - 嵌套文件夹
# @name 创建文件夹-嵌套
POST {{baseUrl}}/system/file/browse/mkdir
Content-Type: application/x-www-form-urlencoded

parentPath=/test/&name=nested-folder

> {%
client.test("创建嵌套文件夹", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(response.body.isDirectory === true, "应标识为目录");
});

client.log("✅ 嵌套文件夹创建成功: " + response.body.path);
%}

###

### TC-2.5.3 创建文件夹 - 根目录
# @name 创建文件夹-根目录
POST {{baseUrl}}/system/file/browse/mkdir
Content-Type: application/x-www-form-urlencoded

name=root-folder-{{ $timestamp }}

> {%
client.test("在根目录创建文件夹", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    client.assert(response.body.path.startsWith("/"), "路径应以/开头");
});

client.log("✅ 根目录文件夹创建成功: " + response.body.path);
%}

