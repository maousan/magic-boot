# ===========================================
# Magic Boot Docker 环境变量配置
# ===========================================

# 是否启用 Docker 内置 MySQL/Redis
# true: 使用 compose 中的 mysql/redis 服务
# false: 使用外部数据库与缓存（请在下方填写连接信息）
USE_DOCKER_DB=true

# -------------------------------------------
# MySQL
# -------------------------------------------
MYSQL_DATABASE=magic-boot
MYSQL_USER=magic
MYSQL_PASSWORD=Magic@2026
# MYSQL_ROOT_PASSWORD=root123456
# MYSQL_HOST=mysql
# MYSQL_PORT=3306

# -------------------------------------------
# Redis
# -------------------------------------------
EXTEND_REDIS_ENABLED=true
REDIS_PORT=6379
REDIS_PASSWORD=Magic@Redis2026
REDIS_HOST=redis

# -------------------------------------------
# 应用
# -------------------------------------------
APP_PORT=8089
SPRING_PROFILES_ACTIVE=dingxinheping
SPRING_FLYWAY_ENABLED=true
UPLOAD_DIR=/app/uploads

# -------------------------------------------
# 外部数据源示例（USE_DOCKER_DB=false 时使用）
# -------------------------------------------
# SPRING_DATASOURCE_URL=jdbc:mysql://192.168.2.90:3306/magic-boot?useSSL=false&zeroDateTimeBehavior=convertToNull&useUnicode=true&characterEncoding=UTF8&autoReconnect=true&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
# SPRING_DATASOURCE_USERNAME=magic
# SPRING_DATASOURCE_PASSWORD=Magic@2026

# SPRING_DATA_REDIS_HOST=192.168.2.90
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=your-password
# SPRING_DATA_REDIS_DATABASE=0
