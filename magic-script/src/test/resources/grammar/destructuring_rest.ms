/*
    测试对象解构中的剩余属性收集 ...rest 语法
*/

// 测试基本对象剩余属性收集
var {a, b, ...rest} = {a: 1, b: 2, c: 3, d: 4}

// 测试数组剩余属性收集
var [o, p, ...q] = [11,12,13,14,15,16]

// 测试对象解构语法应用于数组（JavaScript 兼容性）
// var {o2, ...p2} = [1,2,3] 在 JavaScript 中：o2=undefined, p2={"0":1,"1":2,"2":3,"length":3}
var {o2, ...p2} = [1,2,3]

// 测试数组解构语法（应该正常工作）
var [a2, b2, ...c2] = [4,5,6,7]

// 测试对象解构语法应用于数组，提取 length 属性
// var {length, ...rest2} = [8,9,10] 在 JavaScript 中：length=3, rest2={"0":8,"1":9,"2":10}
var {length, ...rest2} = [8,9,10]

return a == 1 && b == 2 && rest == {c: 3, d: 4}
    && o == 11 && p == 12 && q == [13,14,15,16]
    && o2 == null && p2 == {"0": 1, "1": 2, "2": 3, "length": 3}
    && a2 == 4 && b2 == 5 && c2 == [6,7]
    && length == 3 && rest2 == {"0": 8, "1": 9, "2": 10}