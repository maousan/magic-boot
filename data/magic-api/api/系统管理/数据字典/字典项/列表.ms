================================
let sql = """
    select
        id,
        value,
        label,
        dict_id,
        remark,
        sort
    from sys_dict_items

    <where>
        is_del = 0

        <if test="label != null and label != ''">
            and label like concat('%', #{label}, '%')
        </if>

        <if test="dictId != null and dictId != ''">
            and dict_id = #{dictId}
        </if>

        <if test="value != null and value != ''">
            and value like concat('%', #{value}, '%')
        </if>
    </where>

    order by sort
"""
return db.page(sql)