================================
import cn.dev33.satoken.stp.StpUtil;
import "@post:/system/security/permissions" as authoritiesList;

if (!StpUtil.isLogin()) {
    exit 402, '请先完成登录'
}

// 使用 anyline 查询用户信息
var user = anyline.query("sys_user", `++id='${StpUtil.getLoginId()}'`)

if (!user) {
    exit 0, '用户不存在'
}

// 删除敏感字段(密码)
user.remove("password")

user.authorities = authoritiesList()
return user