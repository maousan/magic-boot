import cn.dev33.satoken.stp.StpUtil;
import "@post:/system/security/permissions" as authoritiesList; 

var user = db.table("sys_user").where().eq("id",StpUtil.getLoginId()).selectOne()
user.authorities = authoritiesList()
return user