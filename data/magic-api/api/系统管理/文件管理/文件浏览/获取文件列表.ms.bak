================================
import cn.hutool.core.util.StrUtil
import file

// 获取路径参数
if(StrUtil.isBlank(dirPath)){
    dirPath = '/'
}

// 确保路径以 / 结尾
if(!dirPath.endsWith('/')){
    dirPath = dirPath + '/'
}

// 使用 file 模块列出文件
var fileList = file.list(dirPath)

// 转换结果
var result = []
for(item in fileList){
    result.push({
        name: item.getFilename(),
        path: dirPath + item.getFilename(),
        size: item.getSize(),
        isDirectory: false,
        lastModified: item.getLastModified() != null ? item.getLastModified().getTime() : null,
        contentType: item.getContentType(),
        url: item.getUrl(),
        eTag: item.getETag()
    })
}

return {
    currentPath: dirPath,
    files: result,
    total: result.size()
}
