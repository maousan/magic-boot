import org.ssssssss.magicapi.utils.JsonUtils
import log

let row = anyline.query("sys_vtj_project", `++id='${id}'`)

if (!row) {
    exit 0, '获取失败'
}

const project = JsonUtils.readValue(row.getString("project"), Map.class)

return project