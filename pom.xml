<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.1.2</version>
        <relativePath/>
    </parent>

    <groupId>org.ssssssss</groupId>
    <artifactId>magic-boot</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>magic-boot</name>
    <description>magic-boot</description>

    <modules>
        <module>magic-dependencies</module>
        <module>magic-api-parent</module>
        <module>magic-boot-plugins</module>
        <module>magic-editor</module>
        <module>magic-boot-master</module>
        <module>magic-plugin</module>
<!--        <module>magic-plugin-demo</module>-->
<!--        <module>magic-plugin-zintis-led</module>-->
        <module>magic-plugin-api</module>
        <module>magic-script</module>
        <module>tiga-engine</module>
        <module>tiga-engine-spring</module>
        <module>magic-plugin-dongxinheping</module>
        <module>magic-plugin-zintis-rfid</module>
    </modules>

    <properties>
        <!-- 版本号统一管理（CI-Friendly） -->
        <revision>0.0.2</revision>

        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 导入统一依赖管理 BOM -->
            <dependency>
                <groupId>org.ssssssss</groupId>
                <artifactId>magic-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Flatten plugin: 处理 CI-friendly 版本占位符 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
